# /etc/systemd/system/display-autoswitch.service
#
# Runs once at boot (before the display manager starts) and again on every DRM
# hotplug event via 99-drm-hotplug.rules.

[Unit]
Description=Select Xorg config for virtual (dummy) or physical display
Documentation=https://github.com/REPLACE-ME/dgx-spark-virtualscreen-anydesk
DefaultDependencies=no
After=systemd-udev-settle.service local-fs.target
Wants=systemd-udev-settle.service
Before=display-manager.service graphical.target

[Service]
Type=oneshot
RemainAfterExit=no
ExecStart=/usr/local/sbin/display-autoswitch.sh --boot
# Hotplug invocations re-enter the same script without --boot; the flock inside
# the script serialises them.
TimeoutStartSec=90

[Install]
WantedBy=graphical.target multi-user.target
