# /etc/X11/autoswitch/xorg.conf.dummy
#
# Virtual (headless) screen for DGX Spark / GB10 units with no monitor attached.
# Installed to /etc/X11/xorg.conf by display-autoswitch.sh when no physical
# DRM connector reports "connected".
#
# Driver: xserver-xorg-video-dummy (software framebuffer, no GPU acceleration
# for the desktop). CUDA / NVIDIA compute is unaffected — this config only
# governs the X desktop that AnyDesk captures, not the GPU compute stack.
#
# VideoRam 262144 KiB = 256 MiB, enough for 2560x1440 at 32bpp with headroom.

Section "ServerFlags"
    # Stop Xorg auto-attaching the NVIDIA device as a second GPU screen, which
    # produces a second empty screen and confuses AnyDesk's capture.
    Option "AutoAddGPU"    "false"
    Option "BlankTime"     "0"
    Option "StandbyTime"   "0"
    Option "SuspendTime"   "0"
    Option "OffTime"       "0"
EndSection

Section "Monitor"
    Identifier   "DUMMY0"
    HorizSync    5.0 - 1000.0
    VertRefresh  5.0 - 200.0
    # CVT-derived modelines. 1920x1080 is the default; the others let a remote
    # operator pick a larger desktop with xrandr without restarting X.
    Modeline "1920x1080" 148.50 1920 2008 2052 2200 1080 1084 1089 1125 +hsync +vsync
    Modeline "1600x900"  118.25 1600 1696 1856 2112  900  903  908  934 -hsync +vsync
    Modeline "2560x1440" 312.25 2560 2752 3024 3488 1440 1443 1448 1493 -hsync +vsync
EndSection

Section "Device"
    Identifier  "DUMMY-CARD"
    Driver      "dummy"
    VideoRam    262144
EndSection

Section "Screen"
    Identifier   "DUMMY-SCREEN"
    Device       "DUMMY-CARD"
    Monitor      "DUMMY0"
    DefaultDepth 24
    SubSection "Display"
        Depth   24
        Modes   "1920x1080" "1600x900" "2560x1440"
        # Virtual must be >= the largest mode, or xrandr cannot switch up to it.
        Virtual 2560 1440
    EndSubSection
EndSection

Section "ServerLayout"
    Identifier  "DUMMY-LAYOUT"
    Screen  0   "DUMMY-SCREEN" 0 0
EndSection
