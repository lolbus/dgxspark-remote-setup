# /etc/X11/autoswitch/xorg.conf.physical
#
# The config installed to /etc/X11/xorg.conf when a physical monitor IS connected.
#
# IMPORTANT: on a stock DGX Spark there is usually NO /etc/X11/xorg.conf at all —
# Xorg auto-detects the NVIDIA device and the attached panel. That auto-detect
# behaviour is what you want back when a monitor is plugged in.
#
# Therefore display-autoswitch.sh treats an EMPTY xorg.conf.physical as
# "remove /etc/X11/xorg.conf entirely and let Xorg auto-detect".
#
#   - Stock unit, no pre-existing xorg.conf  -> install an EMPTY file. Recommended.
#   - Unit had its own xorg.conf before this repo was applied -> the installer
#     copies that original file here verbatim, and it is restored on hotplug.
#
# The section below is only a reference for a unit that genuinely needs an
# explicit NVIDIA config. It is NOT installed by default.
# VERIFY-ON-UNIT: the BusID and the connector name differ per unit and per driver
# version. Read them from `lspci | grep -i vga` and /sys/class/drm/ before use.
#
# Section "Device"
#     Identifier  "NVIDIA-CARD"
#     Driver      "nvidia"
#     # BusID     "PCI:1@0:0:0"          # VERIFY-ON-UNIT
#     Option      "AllowEmptyInitialConfiguration" "true"
# EndSection
#
# Section "Screen"
#     Identifier  "NVIDIA-SCREEN"
#     Device      "NVIDIA-CARD"
#     Option      "AllowEmptyInitialConfiguration" "true"
# EndSection
