# /etc/udev/rules.d/99-drm-hotplug.rules
#
# Fire the display autoswitch whenever the kernel reports a DRM hotplug event
# (monitor plugged in or pulled out).
#
# --no-block is required: udev RUN+= must return quickly, and the switcher
# debounces and may restart the display manager, which takes seconds.

ACTION=="change", SUBSYSTEM=="drm", ENV{HOTPLUG}=="1", \
    RUN+="/usr/bin/systemctl --no-block start display-autoswitch.service"
